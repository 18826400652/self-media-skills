#!/usr/bin/env bash
# image-cards 入口：ic render|preview <卡片.md> [--preset 名称] [--out 目录]
#                  ic draft <文案.md> [--images 目录]（存进小红书草稿箱，需要 browser-draft 的 bd）
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if [[ "${1:-}" == "draft" ]]; then
  shift
  exec node "$SKILL_DIR/scripts/draft.mjs" "$@"
fi
if [[ ! -d "$SKILL_DIR/node_modules" ]]; then
  echo "未安装依赖，请先运行：cd $SKILL_DIR && npm install" >&2
  exit 1
fi
# 无 sudo 时手动解压的 Chrome 运行库
if [[ -d "$HOME/.local/lib/chrome-deps" ]]; then
  export LD_LIBRARY_PATH="$HOME/.local/lib/chrome-deps${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec node "$SKILL_DIR/scripts/ic.mjs" "$@"
