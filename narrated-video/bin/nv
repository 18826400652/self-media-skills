#!/usr/bin/env bash
# narrated-video 统一入口（正在拆分，见 docs/superpowers/specs/2026-10-16-video-pipeline-restructure-design.md）。
#   nv hf-audio <HyperFrames 工程> [--check] [--pause 秒]   配音 + 逐字时间 + 字幕分组
#   nv render <视频目录> [--sample] [参数]  渲染到 <视频目录>/renders/，完成后自动做成片检查
#   nv verify <成片.mp4>                成片检查
#   nv draft <成片.mp4> --copy <发布文案.md> [--cover 图] [--to douyin|xiaohongshu] [--via browser|phone]  存草稿
#   nv <其他>                           透传给 hyperframes（check/snapshot/preview/doctor/lint…）
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
HF="$SKILL_DIR/node_modules/.bin/hyperframes"

if [[ ! -x "$HF" ]]; then
  echo "未安装依赖，请先运行：cd $SKILL_DIR && npm install（详见 references/setup.md）" >&2
  exit 1
fi

# 本地 TTS 的 Python 环境；无 sudo 时手动解压的 Chrome 运行库
export PATH="$SKILL_DIR/.venv/bin:$PATH"
if [[ -d "$HOME/.local/lib/chrome-deps" ]]; then
  export LD_LIBRARY_PATH="$HOME/.local/lib/chrome-deps${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

cmd="${1:-help}"
shift || true

case "$cmd" in
  verify | draft | hf-audio)
    exec node "$SKILL_DIR/scripts/$cmd.mjs" "$@"
    ;;
  render)
    exec node "$SKILL_DIR/scripts/render.mjs" "$@"
    ;;
  help | -h | --help)
    # 打印文件头的注释（第 2 行起，到第一行非注释为止），加了命令不用再改行号
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
    ;;
  *)
    exec "$HF" "$cmd" "$@"
    ;;
esac
