#!/usr/bin/env bash
# narrated-video 统一入口。
#   nv new <名称> [--date YYYY-MM-DD]   新建一期（按项目配置）
#   nv new --dir <目录>                 在任意目录新建视频工程
#   nv voice <视频目录> [--voice x] [--speed 1.2]   配音 + 时间轴 + 同步
#   nv sync <视频目录>                  只同步时间轴到 index.html
#   nv render <视频目录> [参数]         渲染到 <视频目录>/renders/
#   nv <其他>                           透传给 hyperframes（check/snapshot/preview/doctor/lint…）
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
HF="$SKILL_DIR/node_modules/.bin/hyperframes"

if [[ ! -x "$HF" ]]; then
  echo "未安装依赖，请先运行：cd $SKILL_DIR && npm install（详见 references/setup.md）" >&2
  exit 1
fi

# 本地 TTS 的 Python 环境；无 sudo 时手动解压的 Chrome 运行库
export PATH="$SKILL_DIR/.venv/bin:$PATH"
if [[ -d "$HOME/.local/lib/chrome-deps" ]]; then
  export LD_LIBRARY_PATH="$HOME/.local/lib/chrome-deps${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

cmd="${1:-help}"
shift || true

case "$cmd" in
  new | voice | sync)
    exec node "$SKILL_DIR/scripts/$cmd.mjs" "$@"
    ;;
  render)
    dir="$(cd "${1:?用法：nv render <视频目录> [参数]}" && pwd)"
    shift
    name="$(basename "$dir")"
    parent="$(basename "$(dirname "$dir")")"
    # 视频目录是作品下的平台子目录（如 03-周报/抖音、2026-10-08-xxx/抖音）时，用作品名命名
    [[ "$parent" =~ ^[0-9]+- ]] && name="$parent"
    mkdir -p "$dir/renders"
    exec "$HF" render "$dir" -o "$dir/renders/$name.mp4" "$@"
    ;;
  help | -h | --help)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    exec "$HF" "$cmd" "$@"
    ;;
esac
