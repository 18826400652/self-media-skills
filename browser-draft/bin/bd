#!/usr/bin/env bash
# browser-draft 入口：在用户已登录的浏览器里执行一个「发草稿」步骤脚本。
#   bd run <步骤.py> [载荷.json]   载荷路径通过 BD_PAYLOAD 传给脚本
#   bd tabs                        列出浏览器标签页（检查能否连上）
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# 从当前目录往上找项目配置 browser-draft.config.json，读出 cdpPort
config_port() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    if [[ -f "$d/browser-draft.config.json" ]]; then
      node -e 'const c=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")); if (c.cdpPort) console.log(c.cdpPort)' "$d/browser-draft.config.json"
      return
    fi
    d="$(dirname "$d")"
  done
}

# 连接浏览器：优先 BU_CDP_WS；其次 BD_CDP_PORT / 项目配置 cdpPort（自动化专用浏览器用 --remote-debugging-port 启动，不弹允许）；
# 最后找最近启动的 Edge / Chrome 的 DevToolsActivePort
resolve_ws() {
  [[ -n "${BU_CDP_WS:-}" ]] && return
  local port="${BD_CDP_PORT:-$(config_port)}"
  if [[ -n "$port" ]]; then
    local ws
    ws="$(curl -s --noproxy '*' -m 5 "http://127.0.0.1:$port/json/version" | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{try{console.log(JSON.parse(d).webSocketDebuggerUrl||"")}catch{}})' || true)"
    if [[ -z "$ws" ]]; then
      echo "✗ 连不上 $port 端口的浏览器：先打开带远程调试的浏览器（如桌面上的「Edge 自动化」），并登录要发草稿的平台" >&2
      exit 1
    fi
    export BU_CDP_WS="$ws"
    # WSL 里连的是 Windows 上的浏览器：上传文件时要把路径转成 Windows 能读的形式
    grep -qi microsoft /proc/version 2>/dev/null && export BD_WINDOWS_BROWSER=1
    return 0
  fi
  local candidates=(
    "${BD_PORT_FILE:-}"
    /mnt/c/Users/*/AppData/Local/Microsoft/Edge/"User Data"/DevToolsActivePort
    /mnt/c/Users/*/AppData/Local/Google/Chrome/"User Data"/DevToolsActivePort
    "$HOME/.config/microsoft-edge/DevToolsActivePort"
    "$HOME/.config/google-chrome/DevToolsActivePort"
    "$HOME/Library/Application Support/Microsoft Edge/DevToolsActivePort"
    "$HOME/Library/Application Support/Google/Chrome/DevToolsActivePort"
  )
  local newest=""
  for f in "${candidates[@]}"; do
    [[ -n "$f" && -f "$f" ]] || continue
    [[ -z "$newest" || "$f" -nt "$newest" ]] && newest="$f"
  done
  if [[ -z "$newest" ]]; then
    echo "✗ 找不到浏览器的远程调试端口：在 Edge 打开 edge://inspect/#remote-debugging（Chrome 是 chrome://inspect）勾选允许远程调试" >&2
    exit 1
  fi
  local found_port
  found_port="$(sed -n 1p "$newest" | tr -d '\r')"
  export BU_CDP_WS="ws://127.0.0.1:${found_port}$(sed -n 2p "$newest" | tr -d '\r')"
  echo "⚠ 当前目录不在作品项目里（往上没找到 browser-draft.config.json），改连 $found_port 端口上正在运行的浏览器（$newest）；发草稿请到作品项目目录里跑" >&2
  # WSL 里连的是 Windows 上的浏览器：上传文件时要把路径转成 Windows 能读的形式
  [[ "$newest" == /mnt/* ]] && export BD_WINDOWS_BROWSER=1
  return 0
}

export BU_NAME="${BU_NAME:-browser-draft}"   # 单独的 daemon，不和同时在用这个浏览器的其他会话（pd rec、sc bench）抢标签页
command -v browser-harness >/dev/null || { echo "✗ 需要 browser-harness（https://github.com/browser-use/browser-harness）" >&2; exit 1; }

case "${1:-}" in
  run)
    step="${2:?用法：bd run <步骤.py> [载荷.json]}"
    [[ -f "$step" ]] || { echo "✗ 步骤脚本不存在：$step" >&2; exit 1; }
    resolve_ws
    export BD_PAYLOAD="${3:-}"
    export BD_OUT="${BD_OUT:-${TMPDIR:-/tmp}/browser-draft}"
    mkdir -p "$BD_OUT"
    exec browser-harness -c "$(cat "$SKILL_DIR/lib/copy_format.py" "$SKILL_DIR/lib/bd.py" "$step")"
    ;;
  tabs)
    resolve_ws
    exec browser-harness -c 'for t in list_tabs(include_chrome=False): print(t)'
    ;;
  *)
    echo "用法：bd run <步骤.py> [载荷.json] | bd tabs" >&2
    exit 1
    ;;
esac
